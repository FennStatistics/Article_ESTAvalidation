  TITLE: SEM ESTA;
  DATA: FILE = "ESTA_SEM.dat";
   LISTWISE=ON;
  VARIABLE:
    NAMES ARE
      bi01 gen01 bi02 genr02 bir03 gen03 bir04 genr04 bi05 gen05 bir06 genOwn06
      bi07 genOwnr07 bir08 bi09 b01 r01 b02 r02 b03 r03 b04 r04 b05 r05
      n01 p01 n02 p02 n03 p03 n04 p04 n05 p05 n06 p06 n07 p07 n08 p08 n09 p09 n10 p10
      trust01 trust02 trust03 trust04 trust05 trust06 trust07
      hedonism01 hedonism02 hedonism03 hedonism04 hedonism05
      hedonism06 hedonism07 hedonism08 hedonism09
      utilitarian01 utilitarian02 utilitarian03 utilitarian04 utilitarian05
      utilitarian06 utilitarian07 utilitarian08 utilitarian09
      contractualist01 contractualist02 contractualist03 contractualist04
      contractualist05 contractualist06
      deontology01 deontology02 deontology03 deontology04 deontology05
      deontology06 deontology07 deontology08
      virtue01 virtue02 virtue03 virtue04 virtue05 virtue06 virtue07 virtue08 virtue09
      relativist01 relativist02 relativist03 relativist04 relativist05
      ;
    MISSING = .;

    ! remove:
    ! Hedonism: hedonism02, hedonism03, hedonism09
    ! Deontology: deontology01, deontology07
    ! Virtue Ethics: virtue06, virtue07
    ! mixed: genOwn06, genOwnr07, p06
    USEVARIABLES ARE
      bi01 gen01 bi02 genr02 bir03 gen03 bir04 genr04 bi05 gen05 bir06
      bi07 bir08 bi09 b01 r01 b02 r02 b03 r03 b04 r04 b05 r05
      n01 p01 n02 p02 n03 p03 n04 p04 n05 p05 n06 n07 p07 n08 p08 n09 p09 n10 p10
      trust01 trust02 trust03 trust04 trust05 trust06 trust07
      hedonism01 hedonism04 hedonism05 hedonism06 hedonism07 hedonism08
      utilitarian01 utilitarian02 utilitarian03 utilitarian04 utilitarian05
      utilitarian06 utilitarian07 utilitarian08 utilitarian09
      contractualist01 contractualist02 contractualist03 contractualist04
      contractualist05 contractualist06
      deontology02 deontology03 deontology04 deontology05 deontology06 deontology08
      virtue01 virtue02 virtue03 virtue04 virtue05 virtue08 virtue09
      relativist01 relativist02 relativist03 relativist04 relativist05
      ;


    ANALYSIS:

        estimator = MLR;

    MODEL:


       ! Acceptability
      Accept BY bi01*
      gen01
      bi02
      genr02
      bir03
      gen03
      bir04
      genr04
      bi05
      gen05
      bir06
      bi07
      bir08
      bi09
      ;
      Accept@1;

      ! Perc. Risk
      Risk BY r01*
      r02
      r03
      r04
      r05
      ;
      Risk@1;

      ! Perc. Benefit
      Benf BY b01*
      b02
      b03
      b04
      b05
      ;
      Benf@1;

      b02 WITH b03; ! adjustment

      ! negative Emotion
      negEmo BY n01*
      n02
      n03
      n04
      n05
      n06
      n07
      n08
      n09
      n10
      ;
      negEmo@1;


      n03 WITH n07; ! adjustment
      n05 WITH n06; ! adjustment
      n04 WITH n10; ! adjustment
      ! n08 WITH n09; ! adjustment


      ! positive Emotion
      posEmo BY p01*
      p02
      p03
      p04
      p05
      p07
      p08
      p09
      p10
      ;
      posEmo@1;

      p01 WITH p09; ! adjustment
      p09 WITH p10; ! adjustment
      p03 WITH p10; ! adjustment


      ! trust
      Trust BY trust01*
      trust02
      trust03
      trust04
      trust05
      trust06
      trust07
      ;
      Trust@1;


      trust02 WITH trust03; ! adjustment
      trust04 WITH trust05; ! adjustment
      trust06 WITH trust07; ! adjustment


     !------------------------
     ! Hedonism
      Hedo BY
        hedonism01*
        hedonism04
        hedonism05
        hedonism06
        hedonism07
        hedonism08;
      Hedo@1;

      !------------------------
      ! Utilitarianism
      Util BY
        utilitarian01*
        utilitarian02
        utilitarian03
        utilitarian04
        utilitarian05
        utilitarian06
        utilitarian07
        utilitarian08
        utilitarian09;
      Util@1;

      !------------------------
      ! Contractualism
      Cont BY
        contractualist01*
        contractualist02
        contractualist03
        contractualist04
        contractualist05
        contractualist06;
      Cont@1;

      !------------------------
      ! Deontology
      Deon BY
        deontology02*
        deontology03
        deontology04
        deontology05
        deontology06
        deontology08;
      Deon@1;

      !------------------------
      ! Virtue Ethics
      Virt BY
        virtue01*
        virtue02
        virtue03
        virtue04
        virtue05
        virtue08
        virtue09;
      Virt@1;

      !------------------------
      ! Relativism
      Rela BY
        relativist01*
        relativist02
        relativist03
        relativist04
        relativist05;
      Rela@1;

  ! Second Order Factor ESTA
    ESTA BY Hedo* Util Cont Deon Virt Rela;


      ! SEM:
    Accept ON Risk Benf negEmo posEmo ESTA;
    Risk ON negEmo posEmo Trust ESTA;
    Benf ON negEmo posEmo Trust ESTA;

    negEmo ON Trust ESTA;
    posEmo ON Trust ESTA;

    Trust ON ESTA;

    Risk WITH Benf (c1);
  ESTA@1;

  MODEL TEST:

    0 = c1+1; ! not equal to -1

  OUTPUT:
  sampstat standardized stdyx residual modindices;
  PLOT:

      type = plot3;




