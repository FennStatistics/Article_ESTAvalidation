@article{rayyan-800531247,
  title={Understanding ethical purchasing behavior: Validation of an enhanced        stage model of ethical behavior},
  year={2019},
  month={5},
  journal={JOURNAL OF RETAILING AND CONSUMER SERVICES},
  issn={0969-6989},
