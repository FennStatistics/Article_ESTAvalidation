  year={1996},
  journal={AMERICAN BUSINESS LAW JOURNAL},
  issn={0002-7766},
  volume={34},
  number={2},
  pages={277-&},
  author={Robin, DP and King, EW and Reidenbach, RE and Robin, DP and King, EW and Reidenbach, RE},
  language={English},
  publisher={AMER BUSINESS LAW JOURNAL},
  address={C/O GREGORY NAPLES, MARQUETTE UNIV DEPT ACCOUNTING COLL BUSINESS ADM,        MILWAUKEE, WI 53233},
  keywords={BUSINESS ETHICS, LEGAL ETHICS, Decision Making},
  abstract={The study of legal ethics usually focuses on philosophical explanations for ethical or unethical behavior. Empirical study has not been brought to bear on this important subject. The multidimensional ethics scale (MES) has been used to examine the ethical decision making process in a number of professions, but not the legal profession. This exploratory study, performed by surveying a random sample of attorneys, is an early attempt to explore empirically how attorneys arrive at an ethical decision. It introduces a new construct, ''client duty'' and integrates it with the more established constructs of the MES (moral equity, relativism, and contractualism). Respondents were asked to, react to three scenarios, each of which posed an ethical dilemma. The three established constructs of the MES and the new construct produced very satisfactory results in several tests of validity. Modeling efforts with these constructs were highly suggestive of an ethical decision making process that is somewhat different than currently existing efforts and is particularly appropriate for the legal profession.},
  note={RAYYAN-INCLUSION: {"julius.fenn"=>"Excluded"}}
}

@article{rayyan-800531530,
  title={Religiosity, ethical ideology, and intentions to report a peer's        wrongdoing},
  year={1996},
  month={11},
  journal={JOURNAL OF BUSINESS ETHICS},
  issn={0167-4544},
  volume={15},
  number={11},
  pages={1161-1174},
  author={Barnett, T and Bass, K and Brown, G and Barnett, T and Bass, K and Brown, G},
  language={English},
  publisher={SPRINGER},
  address={VAN GODEWIJCKSTRAAT 30, 3311 GZ DORDRECHT, NETHERLANDS},
  keywords={PERSONAL MORAL PHILOSOPHIES, CHRISTIAN ORTHODOXY, WHISTLE-BLOWERS, UNETHICAL BEHAVIOR, DECISION-MAKING, BUSINESS, ORGANIZATIONS, MODEL, FUNDAMENTALISM, PERSPECTIVE},
  abstract={Peer reporting is a specific form of whistleblowing in which an individual discloses the wrongdoing of a peer. Previous studies have examined situational variables thought to influence a person's decision to report the wrongdoing of a peer. The present study looked at peer reporting from the individual level. Five hypotheses were developed concerning the relationships between (1) religiosity and ethical ideology, (2) ethical ideology and ethical judgments about peer reporting, and (3) ethical judgments and intentions to report peer wrongdoing.        Subjects read a vignette concerning academic cheating, and were asked to respond to a questionnaire concerning the vignette. Data were analyzed using structural equation methodology.        Results indicted that religiosity was positively associated with an ethical ideology of non-relativism. Individuals whose ethical ideologies could be described as idealistic and non-relativistic were more likely to state that reporting a peer's cheating was ethical. In turn, individuals who believed reporting a peer's cheating was ethical were more likely to say that they would report a peer's cheating.},
  note={RAYYAN-INCLUSION: {"julius.fenn"=>"Excluded"}}
}

