@article{rayyan-800531292,
  title={Responsible management education: Mapping the field in the context of        the SDGs},
  year={2017},
  month={7},
  journal={INTERNATIONAL JOURNAL OF MANAGEMENT EDUCATION},
  issn={1472-8117},
  volume={15},
  number={2},
  pages={93-103},
